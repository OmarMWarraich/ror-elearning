<% content_for :title, "Courses" %>

<div class="page-header">
  <h1>Courses</h1>
  <p class="lead">Browse our collection of courses and start learning today.</p>
</div>

<% if notice %>
  <p style="color: green"><%= notice %></p>
<% end %>

<div id="courses" class="row">
  <% @courses.each do |course| %>
    <div class="col-md-6 col-lg-4">
      <%= render course %>
      <p class="mb-4"><%= link_to "Show this course", course, class: "btn btn-outline-primary btn-sm" %></p>
    </div>
  <% end %>
</div>

<% if can? :create, Course %>
  <%= link_to "New course", new_course_path, class: "btn btn-primary" %>
<% end %>
