<div class="card mb-3 course-card" id="<%= dom_id course %>">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <h5 class="card-title mb-1"><%= course.title %></h5>
        <h6 class="card-subtitle text-muted mb-2"><%= course.category&.name || "Uncategorized" %></h6>
      </div>
      <span class="badge bg-light text-dark border"><%= course.status.humanize %></span>
    </div>
    <p class="card-text text-muted mb-2">
      <%= course.price_cents.zero? ? "Free" : number_to_currency(course.price_cents / 100.0) %>
      <% if course.duration_in_minutes.present? %>
        &middot; <%= course.duration_in_minutes %> min
      <% end %>
    </p>
  </div>
</div>
