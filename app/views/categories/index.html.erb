<% content_for :title, "Categories" %>

<h1>Categories</h1>

<div id="categories">
  <% @categories.each do |category| %>
    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title"><%= link_to category.name, category %></h5>
        <p class="card-text"><%= category.description %></p>
        <% if can? :update, category %>
          <%= link_to "Edit", edit_category_path(category), class: "btn btn-sm btn-outline-primary" %>
        <% end %>
        <% if can? :destroy, category %>
          <%= button_to "Destroy", category, method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<% if can? :create, Category %>
  <%= link_to "New category", new_category_path, class: "btn btn-primary" %>
<% end %>
