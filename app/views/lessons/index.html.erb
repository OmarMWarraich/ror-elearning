<% content_for :title, "#{@course.title} - Lessons" %>

<h1>Lessons for <%= @course.title %></h1>

<div id="lessons">
  <% @lessons.each do |lesson| %>
    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title"><%= link_to lesson.title, [lesson.course, lesson] %></h5>
        <p class="card-text"><%= lesson.status.humanize %></p>
        <% if can? :update, lesson %>
          <%= link_to "Edit", edit_lesson_path(lesson), class: "btn btn-sm btn-outline-primary" %>
        <% end %>
        <% if can? :destroy, lesson %>
          <%= button_to "Destroy", lesson, method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<% if can? :create, Lesson.new(course: @course) %>
  <%= link_to "New lesson", new_course_lesson_path(@course), class: "btn btn-primary" %>
<% end %>
<%= link_to "Back to course", @course, class: "btn btn-secondary" %>
